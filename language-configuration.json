{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [["<", ">"]],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "<", "close": ">", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["'", "'"],
    ["<", ">"]
  ],
  "folding": {
    "offSide": true
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[^#|\"\\s][^#|]*:\\s*$",
    "decreaseIndentPattern": "^\\s*$"
  },
  "wordPattern": "[^\\s\"'<>|#@:]+"
}
